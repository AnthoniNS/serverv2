:80 {
	handle /* {
		# Raiz base onde estão todas as pastas (Pagina1, pagina2, pagina3...)
		root * /mnt/e/serve-node/serve-node/Projects/www

		# ✅ Tenta servir:
		#   /orkut          → /orkut/index.php ou /orkut/index.html
		#   /orkut/         → idem
		#   /orkut/post.php → /orkut/post.php
		try_files {path}/index.php {path}/index.html {path} =404

		php_fastcgi unix//var/run/php/php8.5-fpm.sock
		file_server
	}
}
