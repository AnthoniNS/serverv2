<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Serve Dashboard - Git</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <!-- Google Fonts -->
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          fontSize: {
            'xs': ['0.75rem', { lineHeight: '1rem' }],
            'sm': ['0.8125rem', { lineHeight: '1.25rem' }],
            'base': ['0.875rem', { lineHeight: '1.5rem' }],
            'lg': ['1rem', { lineHeight: '1.75rem' }],
            'xl': ['1.125rem', { lineHeight: '1.75rem' }],
            '2xl': ['1.25rem', { lineHeight: '2rem' }],
          },
          spacing: {
            '18': '4.5rem',
            '88': '22rem',
          },
          colors: {
            primary: {
              50: '#f0f9ff',
              100: '#e0f2fe',
              200: '#bae6fd',
              300: '#7dd3fc',
              400: '#38bdf8',
              500: '#0ea5e9',
              600: '#0284c7',
              700: '#0369a1',
              800: '#075985',
              900: '#0c4a6e',
            },
            dark: {
              50: '#f8fafc',
              100: '#f1f5f9',
              200: '#e2e8f0',
              300: '#cbd5e1',
              400: '#94a3b8',
              500: '#64748b',
              600: '#475569',
              700: '#334155',
              800: '#1e293b',
              900: '#0f172a',
            }
          }
        }
      }
    }
  </script>
  <style>
    :root {
      --primary-color: #0ea5e9;
      --primary-hover: #0284c7;
    }

    body {
      font-family: 'Inter', sans-serif;
      font-size: 0.875rem;
      transition: background-color 0.3s, color 0.3s;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      padding: 0.125rem 0.5rem;
      border-radius: 9999px;
      font-size: 0.6875rem;
      font-weight: 500;
    }

    .status-badge.success {
      background-color: rgba(16, 185, 129, 0.1);
      color: rgb(6, 95, 70);
    }

    .dark .status-badge.success {
      background-color: rgba(16, 185, 129, 0.2);
      color: rgb(110, 231, 183);
    }

    .modal-backdrop {
      backdrop-filter: blur(4px);
    }

    .sidebar {
      transition: all 0.3s ease;
    }

    .sidebar-collapsed {
      width: 4rem !important;
    }

    .sidebar-collapsed .sidebar-text {
      display: none !important;
    }

    @media (max-width: 768px) {
      .sidebar {
        transform: translateX(-100%);
      }

      .sidebar.open {
        transform: translateX(0);
      }
    }

    .custom-toast {
      position: fixed;
      top: 1rem;
      right: 1rem;
      z-index: 1050;
      max-width: 350px;
      padding: 0.75rem 1rem;
      border-radius: 0.5rem;
      color: white;
      font-size: 0.875rem;
      font-weight: 500;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
      display: flex;
      align-items: center;
      justify-content: space-between;
      opacity: 0;
      transform: translateX(100%);
      transition: opacity 0.3s, transform 0.3s;
    }

    .custom-toast.show {
      opacity: 1;
      transform: translateX(0);
    }

    .custom-toast.success {
      background-color: #10b981;
    }

    .custom-toast.danger {
      background-color: #ef4444;
    }

    .custom-toast.warning {
      background-color: #f59e0b;
    }

    .custom-toast.info {
      background-color: #3b82f6;
    }

    .toast-close {
      margin-left: 0.75rem;
      cursor: pointer;
      opacity: 0.8;
      transition: opacity 0.2s;
    }

    .toast-close:hover {
      opacity: 1;
    }
  </style>
</head>

<body
  class="bg-gray-50 dark:bg-gray-900 text-gray-800 dark:text-gray-200 min-h-screen flex flex-col justify-between text-sm">
  <!-- Container principal do conteúdo -->
  <div class="flex flex-col flex-1">
    <!-- Header -->
    <header class="bg-white dark:bg-gray-800 shadow-sm border-b border-gray-200 dark:border-gray-700">
      <div class="flex items-center justify-between px-4 py-2">
        <div class="flex items-center">
          <button id="sidebarToggle"
            class="lg:hidden mr-3 p-1.5 rounded-md text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700">
            <i class="bi bi-list text-lg"></i>
          </button>
          <button id="sidebarCollapse"
            class="hidden lg:flex mr-3 p-1.5 rounded-md text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700">
            <i class="bi bi-layout-sidebar text-lg"></i>
          </button>
          <div class="flex items-center">
            <i class="bi bi-hdd-stack text-xl text-primary-600 dark:text-primary-400 mr-2"></i>
            <h1 class="text-lg font-bold text-gray-900 dark:text-white">Serve Dashboard</h1>
          </div>
        </div>
        <div class="flex items-center space-x-3">
          <!-- Theme Toggle -->
          <button id="themeToggle"
            class="p-1.5 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600">
            <i class="bi bi-sun hidden dark:block text-sm"></i>
            <i class="bi bi-moon block dark:hidden text-sm"></i>
          </button>
          <!-- User Menu -->
          <div class="relative">
            <button id="userMenuButton"
              class="flex items-center space-x-2 p-1 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700">
              <div
                class="w-7 h-7 rounded-full bg-primary-500 flex items-center justify-center text-white font-medium text-sm">
                <i class="bi bi-person"></i>
              </div>
            </button>
            <!-- Dropdown Menu -->
            <div id="userMenu"
              class="absolute right-0 mt-2 w-44 bg-white dark:bg-gray-800 rounded-md shadow-lg py-1 z-10 hidden border border-gray-200 dark:border-gray-700">
              <a href="/"
                class="block px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
                <i class="bi bi-house mr-2"></i>Início
              </a>
              <a href="/dashboard"
                class="block px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
                <i class="bi bi-terminal mr-2"></i>Node
              </a>
              <a href="/caddy"
                class="block px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
                <i class="bi bi-globe mr-2"></i>Domínios
              </a>
              <a href="/docker"
                class="block px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
                <i class="bi bi-box-seam mr-2"></i>Docker
              </a>
              <a href="/git"
                class="block px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-300">
                <i class="bi bi-git mr-2"></i>Git
              </a>
              <a href="/auto"
                class="block px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
                <i class="bi bi-rocket-takeoff mr-2"></i>AutoInstall
              </a>
              <a href="/composer"
                class="block px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
                <i class="bi bi-box mr-2"></i>Composer
              </a>
              <a href="/filemanager"
                class="block px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
                <i class="bi bi-archive mr-2"></i>File Manager
              </a>
              <div class="border-t border-gray-200 dark:border-gray-700 my-1"></div>
              <a href="/logout"
                class="block px-3 py-1.5 text-sm text-red-600 dark:text-red-400 hover:bg-gray-100 dark:hover:bg-gray-700">
                <i class="bi bi-box-arrow-right mr-2"></i>Sair
              </a>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="flex">
      <!-- Sidebar -->
      <aside id="sidebar"
        class="sidebar w-56 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 h-[calc(100vh-49px)] fixed lg:static z-20 transition-all duration-300">
        <nav class="p-3">
          <ul class="space-y-1">
            <li>
              <a href="/"
                class="flex items-center px-3 py-1.5 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-sm">
                <i class="bi bi-house mr-2.5 sidebar-icon"></i>
                <span class="sidebar-text">Início</span>
              </a>
            </li>
            <li>
              <a href="/dashboard"
                class="flex items-center px-3 py-1.5 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-sm">
                <i class="bi bi-terminal mr-2.5 sidebar-icon"></i>
                <span class="sidebar-text">Node</span>
              </a>
            </li>
            <li>
              <a href="/caddy"
                class="flex items-center px-3 py-1.5 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-sm">
                <i class="bi bi-globe mr-2.5 sidebar-icon"></i>
                <span class="sidebar-text">Domínios</span>
              </a>
            </li>
            <li>
              <a href="/docker"
                class="flex items-center px-3 py-1.5 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-sm">
                <i class="bi bi-box-seam mr-2.5 sidebar-icon"></i>
                <span class="sidebar-text">Docker</span>
              </a>
            </li>
            <li>
              <a href="/git"
                class="flex items-center px-3 py-1.5 bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-300 rounded-lg text-sm">
                <i class="bi bi-git mr-2.5 sidebar-icon"></i>
                <span class="sidebar-text">Git</span>
              </a>
            </li>
            <li>
              <a href="/auto"
                class="flex items-center px-3 py-1.5 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-sm">
                <i class="bi bi-rocket-takeoff mr-2.5 sidebar-icon"></i>
                <span class="sidebar-text">AutoInstall</span>
              </a>
            </li>
            <li>
              <a href="/composer"
                class="flex items-center px-3 py-1.5 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-sm">
                <i class="bi bi-box mr-2.5 sidebar-icon"></i>
                <span class="sidebar-text">Composer</span>
              </a>
            </li>
            <li>
              <a href="/filemanager"
                class="flex items-center px-3 py-1.5 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-sm">
                <i class="bi bi-archive mr-2.5 sidebar-icon"></i>
                <span class="sidebar-text">File Manager</span>
              </a>
            </li>
          </ul>
        </nav>
      </aside>
      <!-- Main Content -->
      <main id="mainContent" class="flex-1 p-4 transition-all duration-300">
        <div class="mb-4">
          <h2 class="text-xl font-bold text-gray-900 dark:text-white flex items-center">
            <i class="bi bi-git mr-2 text-primary-600 dark:text-primary-400"></i>
            Repositórios Git
          </h2>
          <p class="text-gray-600 dark:text-gray-400 mt-0.5 text-sm">Gerencie seus repositórios Git clonados</p>
        </div>

        <!-- Repositories Table -->
        <div
          class="bg-white dark:bg-gray-800 rounded-lg shadow border border-gray-200 dark:border-gray-700 overflow-hidden">
          <div
            class="px-4 py-3 border-b border-gray-200 dark:border-gray-700 flex flex-col sm:flex-row gap-3 justify-between items-center">
            <h3 class="text-base font-medium text-gray-900 dark:text-white">Lista de Repositórios</h3>
            <button onclick="showCloneModal()"
              class="flex items-center px-2.5 py-1.5 bg-primary-600 hover:bg-primary-700 text-white rounded text-sm font-medium transition-colors">
              <i class="bi bi-plus-lg mr-1.5"></i>
              Adicionar Repositório
            </button>
          </div>
          <div class="p-3">
            <div class="list-wrapper">
              <!-- MOBILE: Cards (hidden on md+) -->
              <div id="reposCardView" class="md:hidden space-y-3"></div>
              <!-- DESKTOP: Table (hidden on mobile) -->
              <div class="hidden md:block overflow-x-auto">
                <table class="w-full">
                  <thead>
                    <tr>
                      <th class="text-left px-3 py-2 bg-gray-50 dark:bg-gray-700 text-xs font-medium">Nome</th>
                      <th class="text-left px-3 py-2 bg-gray-50 dark:bg-gray-700 text-xs font-medium">Tipo</th>
                      <th class="text-left px-3 py-2 bg-gray-50 dark:bg-gray-700 text-xs font-medium">Caminho</th>
                      <th class="text-left px-3 py-2 bg-gray-50 dark:bg-gray-700 text-xs font-medium">Ações</th>
                    </tr>
                  </thead>
                  <tbody id="reposTableBody" class="divide-y divide-gray-200 dark:divide-gray-700"></tbody>
                </table>
              </div>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <!-- Footer -->
  <footer class="bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 py-3 w-full">
    <div class="px-4 text-center text-gray-500 dark:text-gray-400 text-xs">
      &copy; <span id="currentYear"></span> Serve Dashboard - Git Manager
    </div>
  </footer>

  <!-- Custom Toast -->
  <div id="customToast" class="custom-toast hidden">
    <span id="toastMessage"></span>
    <span class="toast-close" onclick="hideToast()">&times;</span>
  </div>

  <!-- Modal: Clonar Repositório -->
  <div class="modal fade fixed inset-0 z-50 overflow-auto bg-black bg-opacity-50 modal-backdrop hidden" id="cloneModal">
    <div class="flex items-center justify-center min-h-screen p-4">
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl w-full max-w-md">
        <div class="px-4 py-3 border-b border-gray-200 dark:border-gray-700 flex justify-between items-center">
          <h3 class="text-base font-medium text-gray-900 dark:text-white">
            Clonar Novo Repositório
          </h3>
          <button type="button" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
            onclick="closeCloneModal()">
            <i class="bi bi-x-lg text-lg"></i>
          </button>
        </div>
        <div class="p-4">
          <div class="mb-3">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">URL do Repositório</label>
            <input type="text" id="repoUrl"
              class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-md text-gray-900 dark:text-gray-200 focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
              placeholder="https://github.com/user/repo.git" required>
          </div>
          <div class="mb-3">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Tipo de Projeto</label>
            <select id="projectType"
              class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-md text-gray-900 dark:text-gray-200 focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
              required>
              <option value="app">App (Node.js)</option>
              <option value="www">WWW (PHP, HTML, etc)</option>
              <option value="docker">Docker</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Nome da Pasta
              (opcional)</label>
            <input type="text" id="projectName"
              class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-md text-gray-900 dark:text-gray-200 focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
              placeholder="Deixe em branco para usar nome do repo">
          </div>
        </div>
        <div class="px-4 py-3 border-t border-gray-200 dark:border-gray-700 flex justify-end space-x-2">
          <button type="button"
            class="px-3 py-1.5 bg-gray-300 dark:bg-gray-600 text-gray-800 dark:text-gray-200 rounded text-sm hover:bg-gray-400 dark:hover:bg-gray-500 transition-colors"
            onclick="closeCloneModal()">
            Cancelar
          </button>
          <button type="button"
            class="px-3 py-1.5 bg-primary-600 hover:bg-primary-700 text-white rounded text-sm flex items-center transition-colors"
            onclick="cloneRepo()">
            <i class="bi bi-check-lg mr-1.5"></i>
            Clonar
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script>
    // Set current year
    document.getElementById('currentYear').textContent = new Date().getFullYear();

    // Theme management
    const themeToggle = document.getElementById('themeToggle');
    const htmlElement = document.documentElement;
    if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      htmlElement.classList.add('dark');
    } else {
      htmlElement.classList.remove('dark');
    }
    themeToggle.addEventListener('click', () => {
      htmlElement.classList.toggle('dark');
      localStorage.setItem('theme', htmlElement.classList.contains('dark') ? 'dark' : 'light');
    });

    // Sidebar toggle
    const sidebarToggle = document.getElementById('sidebarToggle');
    const sidebar = document.getElementById('sidebar');
    sidebarToggle.addEventListener('click', () => sidebar.classList.toggle('open'));

    const sidebarCollapse = document.getElementById('sidebarCollapse');
    const mainContent = document.getElementById('mainContent');
    sidebarCollapse.addEventListener('click', () => {
      sidebar.classList.toggle('sidebar-collapsed');
      mainContent.classList.toggle('lg:ml-0');
      localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('sidebar-collapsed'));
    });
    if (localStorage.getItem('sidebarCollapsed') === 'true') {
      sidebar.classList.add('sidebar-collapsed');
      mainContent.classList.add('lg:ml-0');
    }

    // User menu
    const userMenuButton = document.getElementById('userMenuButton');
    const userMenu = document.getElementById('userMenu');
    userMenuButton.addEventListener('click', () => userMenu.classList.toggle('hidden'));
    document.addEventListener('click', (e) => {
      if (!userMenuButton.contains(e.target) && !userMenu.contains(e.target)) {
        userMenu.classList.add('hidden');
      }
    });

    // Close sidebar on mobile link click
    sidebar.addEventListener('click', (e) => {
      if (e.target.tagName === 'A' && window.innerWidth < 1024) {
        sidebar.classList.remove('open');
      }
    });

    // Toast
    function showToast(message, type = 'success') {
      const toast = document.getElementById('customToast');
      document.getElementById('toastMessage').textContent = message;
      toast.className = `custom-toast ${type}`;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 3000);
    }
    function hideToast() {
      document.getElementById('customToast').classList.remove('show');
    }

    // Modal functions
    function showCloneModal() {
      document.getElementById('cloneModal').classList.remove('hidden');
    }
    function closeCloneModal() {
      document.getElementById('cloneModal').classList.add('hidden');
    }

    // Load repositories
    async function loadRepos() {
      const tbody = document.getElementById('reposTableBody');
      const cardView = document.getElementById('reposCardView');
      try {
        const res = await fetch('/api/git/repos');
        const data = await res.json();

        if (!data.success || !data.repos.length) {
          tbody.innerHTML = `
            <tr>
              <td colspan="4" class="px-3 py-2 text-center text-gray-500 dark:text-gray-400 text-sm">
                Nenhum repositório Git encontrado.
              </td>
            </tr>
          `;
          cardView.innerHTML = `<p class="text-center text-gray-500 dark:text-gray-400 text-sm py-6">Nenhum repositório Git encontrado.</p>`;
          return;
        }

        // Desktop table rows
        tbody.innerHTML = data.repos.map(repo => `
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
            <td class="px-3 py-2">
              <div class="flex items-center">
                <div class="w-6 h-6 rounded-md bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center text-purple-600 dark:text-purple-400 mr-2">
                  <i class="bi bi-git text-sm"></i>
                </div>
                <span class="font-medium text-gray-900 dark:text-white">${repo.name}</span>
              </div>
            </td>
            <td class="px-3 py-2">
              <span class="status-badge success">${repo.type.toUpperCase()}</span>
            </td>
            <td class="px-3 py-2 text-gray-600 dark:text-gray-400 text-xs" style="max-width:160px">
              <span class="block truncate" title="${repo.path}">${repo.path}</span>
            </td>
            <td class="px-3 py-2">
              <div class="flex space-x-1">
                <button class="px-2 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded text-xs flex items-center" onclick="pullRepo('${repo.path}', '${repo.name}')">
                  <i class="bi bi-arrow-clockwise mr-1"></i> Atualizar
                </button>
              </div>
            </td>
          </tr>
        `).join('');

        // Mobile cards
        cardView.innerHTML = data.repos.map(repo => `
          <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-3 bg-gray-50 dark:bg-gray-700/30">
            <div class="flex items-center mb-1">
              <div class="w-7 h-7 rounded-md bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center text-purple-600 dark:text-purple-400 mr-2 flex-shrink-0">
                <i class="bi bi-git text-sm"></i>
              </div>
              <span class="font-semibold text-gray-900 dark:text-white text-sm">${repo.name}</span>
              <span class="ml-auto inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400">${repo.type.toUpperCase()}</span>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-3 truncate" title="${repo.path}">${repo.path}</p>
            <button class="w-full py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded text-xs font-medium flex items-center justify-center gap-1" onclick="pullRepo('${repo.path}', '${repo.name}')">
              <i class="bi bi-arrow-clockwise"></i> Atualizar
            </button>
          </div>
        `).join('');

      } catch (err) {
        tbody.innerHTML = `
          <tr>
            <td colspan="4" class="px-3 py-2 text-center text-red-600 dark:text-red-400 text-sm">
              Erro ao carregar repositórios: ${err.message}
            </td>
          </tr>
        `;
        cardView.innerHTML = `<p class="text-center text-red-600 dark:text-red-400 text-sm py-6">Erro ao carregar repositórios: ${err.message}</p>`;
      }
    }


    // Clone repository
    async function cloneRepo() {
      const url = document.getElementById('repoUrl').value.trim();
      const type = document.getElementById('projectType').value;
      const name = document.getElementById('projectName').value.trim() || null;

      if (!url) {
        showToast('URL é obrigatória.', 'warning');
        return;
      }

      const btn = event.target;
      const orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm mr-1.5"></span> Clonando...';

      try {
        const res = await fetch('/api/git/clone', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ repoUrl: url, projectType: type, projectName: name })
        });
        const result = await res.json();

        if (result.success) {
          showToast('✅ Clonado com sucesso!', 'success');
          closeCloneModal();
          loadRepos();
          document.getElementById('repoUrl').value = '';
          document.getElementById('projectName').value = '';
        } else {
          showToast('❌ ' + result.error, 'danger');
        }
      } catch (err) {
        showToast('❌ Erro de rede: ' + err.message, 'danger');
      } finally {
        btn.disabled = false;
        btn.innerHTML = orig;
      }
    }

    // Pull repository
    async function pullRepo(path, name) {
      if (!confirm(`Atualizar "${name}" com git pull?`)) return;

      try {
        const res = await fetch('/api/git/pull', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ projectPath: path })
        });
        const result = await res.json();

        if (result.success) {
          showToast(`✅ ${name} atualizado com sucesso!`, 'success');
          loadRepos();
        } else {
          showToast(`❌ Erro: ${result.error}`, 'danger');
        }
      } catch (err) {
        showToast(`❌ Falha na conexão: ${err.message}`, 'danger');
      }
    }

    // Load repos on page load
    document.addEventListener('DOMContentLoaded', () => {
      loadRepos();
    });
  </script>
</body>

</html>