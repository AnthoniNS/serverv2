  <!-- Scripts -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script>
    let projectsList;
    // Set current year in footer
    document.getElementById('currentYear').textContent = new Date().getFullYear();
    // Theme management
    const themeToggle = document.getElementById('themeToggle');
    const htmlElement = document.documentElement;
    // Check for saved theme preference or default to light
    if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      htmlElement.classList.add('dark');
    } else {
      htmlElement.classList.remove('dark');
    }
    themeToggle.addEventListener('click', () => {
      htmlElement.classList.toggle('dark');
      localStorage.setItem('theme', htmlElement.classList.contains('dark') ? 'dark' : 'light');
    });
    // Sidebar toggle for mobile
    const sidebarToggle = document.getElementById('sidebarToggle');
    const sidebar = document.getElementById('sidebar');
    sidebarToggle.addEventListener('click', () => {
      sidebar.classList.toggle('open');
    });
    // Sidebar collapse/expand for desktop
    const sidebarCollapse = document.getElementById('sidebarCollapse');
    const mainContent = document.getElementById('mainContent');
    sidebarCollapse.addEventListener('click', () => {
      sidebar.classList.toggle('sidebar-collapsed');
      mainContent.classList.toggle('lg:ml-0');
      // Save state in localStorage
      const isCollapsed = sidebar.classList.contains('sidebar-collapsed');
      localStorage.setItem('sidebarCollapsed', isCollapsed);
    });
    // Check saved sidebar state
    if (localStorage.getItem('sidebarCollapsed') === 'true') {
      sidebar.classList.add('sidebar-collapsed');
      mainContent.classList.add('lg:ml-0');
    }
    // User menu toggle
    const userMenuButton = document.getElementById('userMenuButton');
    const userMenu = document.getElementById('userMenu');
    userMenuButton.addEventListener('click', () => {
      userMenu.classList.toggle('hidden');
    });
    // Close user menu when clicking outside
    document.addEventListener('click', (event) => {
      if (!userMenuButton.contains(event.target) && !userMenu.contains(event.target)) {
        userMenu.classList.add('hidden');
      }
    });
    // Close sidebar when clicking on a link (mobile)
    sidebar.addEventListener('click', (event) => {
      if (event.target.tagName === 'A' && window.innerWidth < 1024) {
        sidebar.classList.remove('open');
      }
    });

    let currentProject = '';
    let commandsCount = 0;

    // Function to toggle dropdown with proper positioning
    function toggleDropdown(projectId, event) {
      event.stopPropagation();
      const dropdown = document.getElementById(`dropdown-${projectId}`);
      const button = event.target.closest('button');
      const buttonRect = button.getBoundingClientRect();
      // Close other open dropdowns
      document.querySelectorAll('.action-dropdown').forEach(drop => {
        if (drop.id !== `dropdown-${projectId}`) {
          drop.classList.add('hidden');
        }
      });
      // Toggle current dropdown
      dropdown.classList.toggle('hidden');
      if (!dropdown.classList.contains('hidden')) {
        // Position dropdown relative to the button
        const dropdownRect = dropdown.getBoundingClientRect();
        const viewportHeight = window.innerHeight;
        // Calculate position
        let top = buttonRect.bottom + 5;
        let left = buttonRect.left - 100; // Adjust based on dropdown width
        // Ensure dropdown stays within viewport
        if (top + dropdownRect.height > viewportHeight - 10) {
          top = buttonRect.top - dropdownRect.height - 5;
        }
        if (left < 10) {
          left = 10;
        }
        if (left + dropdownRect.width > window.innerWidth - 10) {
          left = window.innerWidth - dropdownRect.width - 10;
        }
        dropdown.style.top = `${top}px`;
        dropdown.style.left = `${left}px`;
      }
    }

    // Alternate dropdown toggler for List.js template rows (uses sibling dropdown)
    function toggleDropdownElement(event) {
      event.stopPropagation();
      const button = event.target.closest('button');
      if (!button) return;
      const dropdown = button.nextElementSibling;
      // Close other open dropdowns
      document.querySelectorAll('.action-dropdown').forEach(drop => {
        if (drop !== dropdown) drop.classList.add('hidden');
      });
      dropdown.classList.toggle('hidden');
      if (!dropdown.classList.contains('hidden')) {
        const buttonRect = button.getBoundingClientRect();
        const dropdownRect = dropdown.getBoundingClientRect();
        const viewportHeight = window.innerHeight;
        let top = buttonRect.bottom + 5;
        let left = buttonRect.left - 100;
        if (top + dropdownRect.height > viewportHeight - 10) {
          top = buttonRect.top - dropdownRect.height - 5;
        }
        if (left < 10) left = 10;
        if (left + dropdownRect.width > window.innerWidth - 10) {
          left = window.innerWidth - dropdownRect.width - 10;
        }
        dropdown.style.top = `${top}px`;
        dropdown.style.left = `${left}px`;
      }
    }

    // Close dropdowns when clicking outside
    document.addEventListener('click', (event) => {
      if (!event.target.closest('.dropdown-container')) {
        document.querySelectorAll('.action-dropdown').forEach(drop => {
          drop.classList.add('hidden');
        });
      }
    });

    async function loadProjects() {
      try {
        const res = await fetch('/api/composer/projects');
        const data = await res.json();
        // Update stats
        document.getElementById('totalProjects').textContent = data.projects.length;
        document.getElementById('commandsExecuted').textContent = commandsCount;

        // Prepare List.js items
        const items = data.projects.map((proj, index) => ({
          'project-name': proj.name,
          'project-version': proj.version || 'N/A',
          'project-path': proj.base,
          'project-id': `project-${index}`,
          'name': proj.name
        }));

        const perPageSelect = document.querySelector('.per-page');
        const perPage = perPageSelect ? parseInt(perPageSelect.value, 10) : 10;

        // Clear existing tbody (if any)
        const tbody = document.querySelector('#projects-wrapper .list-wrapper tbody.list');
        if (tbody) tbody.innerHTML = '';

        // Remove old pagination container if exists
        const oldPagination = document.querySelector('#projects-wrapper .pagination');
        if (oldPagination) oldPagination.remove();

        // Create List.js options and (re)initialize
        const options = {
          valueNames: ['project-name', 'project-path', 'project-version', 'project-id', 'name'],
          item: `
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
              <td class="px-3 py-2">
                <div class="flex items-center">
                  <div class="w-6 h-6 rounded-md bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center text-primary-600 dark:text-primary-400 mr-2">
                    <i class="bi bi-folder text-sm"></i>
                  </div>
                  <div>
                    <div class="project-name font-medium text-gray-900 dark:text-white text-sm"></div>
                    <div class="project-version text-xs text-gray-500 dark:text-gray-400"></div>
                  </div>
                </div>
              </td>
              <td class="px-3 py-2"><div class="project-path font-mono text-xs text-gray-700 dark:text-gray-300"></div></td>
              <td class="px-3 py-2">
                <div class="dropdown-container">
                  <button onclick="toggleDropdownElement(event)" class="flex items-center px-2 py-1 bg-primary-600 hover:bg-primary-700 text-white rounded text-sm font-medium transition-colors">
                    <i class="bi bi-gear mr-1.5"></i>
                    Ações
                    <i class="bi bi-chevron-down ml-1 text-xs"></i>
                  </button>
                  <div class="action-dropdown fixed w-52 bg-white dark:bg-gray-800 rounded-md shadow-lg py-1 z-50 hidden border border-gray-200 dark:border-gray-700">
                    <button class="dropdown-action w-full text-left px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 flex items-center" onclick="runCommand(this.closest('tr').querySelector('.project-name').textContent, 'composer-install')">
                      <i class="bi bi-download mr-2.5 text-blue-500"></i>
                      <div>
                        <div class="font-medium text-sm">Composer Install</div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">Instalar dependências</div>
                      </div>
                    </button>
                    <button class="dropdown-action w-full text-left px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 flex items-center" onclick="runCommand(this.closest('tr').querySelector('.project-name').textContent, 'composer-update')">
                      <i class="bi bi-arrow-clockwise mr-2.5 text-amber-500"></i>
                      <div>
                        <div class="font-medium text-sm">Composer Update</div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">Atualizar dependências</div>
                      </div>
                    </button>
                    <button class="dropdown-action w-full text-left px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 flex items-center" onclick="runCommand(this.closest('tr').querySelector('.project-name').textContent, 'key-generate')">
                      <i class="bi bi-key mr-2.5 text-purple-500"></i>
                      <div>
                        <div class="font-medium text-sm">Key Generate</div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">Gerar chave da aplicação</div>
                      </div>
                    </button>
                    <button class="dropdown-action w-full text-left px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 flex items-center" onclick="runCommand(this.closest('tr').querySelector('.project-name').textContent, 'clear-all')">
                      <i class="bi bi-eraser mr-2.5 text-gray-500"></i>
                      <div>
                        <div class="font-medium text-sm">Clear All</div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">Limpar cache e otimizações</div>
                      </div>
                    </button>
                    <button class="dropdown-action w-full text-left px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 flex items-center" onclick="runCommand(this.closest('tr').querySelector('.project-name').textContent, 'migrate')">
                      <i class="bi bi-database mr-2.5 text-green-500"></i>
                      <div>
                        <div class="font-medium text-sm">Migrate</div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">Executar migrações</div>
                      </div>
                    </button>
                    <div class="border-t border-gray-200 dark:border-gray-700 my-1"></div>
                    <button class="dropdown-action w-full text-left px-3 py-1.5 text-sm text-red-600 dark:text-red-400 flex items-center" onclick="editEnv(this.closest('tr').querySelector('.project-name').textContent)">
                      <i class="bi bi-file-earmark-code mr-2.5"></i>
                      <div>
                        <div class="font-medium text-sm">Editar .env</div>
                        <div class="text-xs text-red-500 dark:text-red-400">Editar variáveis de ambiente</div>
                      </div>
                    </button>
                  </div>
                </div>
              </td>
            </tr>
          `,
          page: perPage,
          pagination: true
        };

        // initialize List.js
        projectsList = new List('projects-wrapper', options, items);

        // Update total counter when list updates
        projectsList.on('updated', function () {
          const total = projectsList.matchingItems ? projectsList.matchingItems.length : 0;
          document.querySelector('.total-items').textContent = total;

          // Clear the old pagination if it exists
          const paginationContainer = document.querySelector('.pagination');
          if (paginationContainer) {
            paginationContainer.innerHTML = '';
          }

          // Only show pagination if we have more items than the per page limit
          if (total > projectsList.page) {
            // Calculate total pages
            const totalPages = Math.ceil(total / projectsList.page);
            const currentPage = projectsList.i;

            // Previous button
            const prevBtn = document.createElement('li');
            prevBtn.innerHTML = `<button class="page px-2 py-1 rounded-md ${currentPage === 1 ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-100 dark:hover:bg-gray-700'}" ${currentPage === 1 ? 'disabled' : ''}>
              <i class="bi bi-chevron-left"></i>
            </button>`;
            if (currentPage !== 1) {
              prevBtn.querySelector('button').addEventListener('click', () => {
                projectsList.previousPage();
              });
            }
            paginationContainer.appendChild(prevBtn);

            // Page numbers
            for (let i = 1; i <= totalPages; i++) {
              const li = document.createElement('li');
              li.innerHTML = `<button class="page px-3 py-1 rounded-md ${i === currentPage ? 'bg-primary-600 text-white' : 'hover:bg-gray-100 dark:hover:bg-gray-700'}">${i}</button>`;
              if (i !== currentPage) {
                li.querySelector('button').addEventListener('click', () => {
                  projectsList.show(i, projectsList.page);
                });
              }
              paginationContainer.appendChild(li);
            }

            // Next button
            const nextBtn = document.createElement('li');
            nextBtn.innerHTML = `<button class="page px-2 py-1 rounded-md ${currentPage === totalPages ? 'opacity-50 cursor-not-allowed' : 'hover:bg-gray-100 dark:hover:bg-gray-700'}" ${currentPage === totalPages ? 'disabled' : ''}>
              <i class="bi bi-chevron-right"></i>
            </button>`;
            if (currentPage !== totalPages) {
              nextBtn.querySelector('button').addEventListener('click', () => {
                projectsList.nextPage();
              });
            }
            paginationContainer.appendChild(nextBtn);
          }
        });

        // Rebind per-page control: recreate the list with new page size on change
        if (perPageSelect) {
          perPageSelect.onchange = function () {
            loadProjects();
          };
        }
      } catch (err) {
        const tbody = document.querySelector('#projects-wrapper .list tbody');
        if (tbody) tbody.innerHTML = `<tr><td colspan="3" class="text-center py-3 text-red-600 dark:text-red-400 text-sm">Erro: ${err.message}</td></tr>`;
      }
    }

    async function runCommand(project, action) {
      currentProject = project;
      commandsCount++;
      document.getElementById('commandsExecuted').textContent = commandsCount;

      // Close dropdown
      document.querySelectorAll('.action-dropdown').forEach(drop => {
        drop.classList.add('hidden');
      });

      const actionNames = {
        'composer-install': 'composer install',
        'composer-update': 'composer update',
        'key-generate': 'php artisan key:generate',
        'clear-all': 'php artisan clear:all',
        'migrate': 'php artisan migrate',
        'migrate-fresh': 'php artisan migrate:fresh'
      };

      document.getElementById('logAction').textContent = `${actionNames[action]} (${project})`;
      document.getElementById('logOutput').textContent = '';
      document.getElementById('logModal').classList.remove('hidden');

      const output = document.getElementById('logOutput');
      const eventSource = new EventSource(`/api/composer/run/${encodeURIComponent(project)}/${action}`, {
        withCredentials: true
      });

      eventSource.onmessage = (event) => {
        const data = JSON.parse(event.data);
        if (data.output) {
          output.textContent += data.output;
        } else if (data.error) {
          output.textContent += `\x1b[31m${data.error}\x1b[0m`;
        } else if (data.exit !== undefined) {
          output.textContent += `
✅ Comando finalizado com código: ${data.exit}`;
          eventSource.close();
        }
        output.scrollTop = output.scrollHeight;
      };

      eventSource.onerror = () => {
        output.textContent += '\n❌ Erro de conexão com o servidor.';
        eventSource.close();
      };
    }

    function closeLogModal() {
      document.getElementById('logModal').classList.add('hidden');
    }

    async function editEnv(project) {
      currentProject = project;

      // Close dropdown
      document.querySelectorAll('.action-dropdown').forEach(drop => {
        drop.classList.add('hidden');
      });

      document.getElementById('envProject').textContent = project;
      document.getElementById('envContent').value = 'Carregando...';
      document.getElementById('envModal').classList.remove('hidden');

      try {
        const res = await fetch(`/api/composer/env/${encodeURIComponent(project)}`);
        const data = await res.json();
        document.getElementById('envContent').value = data.success ? data.content : '';
      } catch (err) {
        document.getElementById('envContent').value = `// Erro: ${err.message}`;
      }
    }

    function closeEnvModal() {
      document.getElementById('envModal').classList.add('hidden');
    }

    async function saveEnv() {
      const content = document.getElementById('envContent').value;
      const btn = event.target;
      const orig = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm mr-1.5"></span> Salvando...';
      try {
        const res = await fetch(`/api/composer/env/${encodeURIComponent(currentProject)}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content })
        });
        const data = await res.json();
        if (data.success) {
          alert('✅ .env salvo com sucesso!');
          closeEnvModal();
        } else {
          alert('❌ ' + data.error);
        }
      } catch (err) {
        alert('Erro: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = orig;
      }
    }

    document.addEventListener('DOMContentLoaded', loadProjects);
  </script>
</body>

</html>