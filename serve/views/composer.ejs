<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Serve Dashboard - Laravel Manager</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <!-- List.js -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/list.js/2.3.1/list.min.js"></script>
  <!-- Google Fonts -->
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          fontSize: {
            'xs': ['0.75rem', { lineHeight: '1rem' }],
            'sm': ['0.8125rem', { lineHeight: '1.25rem' }],
            'base': ['0.875rem', { lineHeight: '1.5rem' }],
            'lg': ['1rem', { lineHeight: '1.75rem' }],
            'xl': ['1.125rem', { lineHeight: '1.75rem' }],
            '2xl': ['1.25rem', { lineHeight: '2rem' }],
          },
          spacing: {
            '18': '4.5rem',
            '88': '22rem',
          },
          colors: {
            primary: {
              50: '#f0f9ff',
              100: '#e0f2fe',
              200: '#bae6fd',
              300: '#7dd3fc',
              400: '#38bdf8',
              500: '#0ea5e9',
              600: '#0284c7',
              700: '#0369a1',
              800: '#075985',
              900: '#0c4a6e',
            },
            dark: {
              50: '#f8fafc',
              100: '#f1f5f9',
              200: '#e2e8f0',
              300: '#cbd5e1',
              400: '#94a3b8',
              500: '#64748b',
              600: '#475569',
              700: '#334155',
              800: '#1e293b',
              900: '#0f172a',
            }
          }
        }
      }
    }
  </script>
  <style>
    :root {
      --primary-color: #0ea5e9;
      --primary-hover: #0284c7;
    }

    body {
      font-family: 'Inter', sans-serif;
      font-size: 0.875rem;
      transition: background-color 0.3s, color 0.3s;
    }

    /* CORREÇÕES PARA DATATABLE NO MODO ESCURO */
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter,
    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_processing,
    .dataTables_wrapper .dataTables_paginate {
      color: inherit !important;
      font-size: 0.8125rem !important;
    }

    .dark .dataTables_wrapper .dataTables_length,
    .dark .dataTables_wrapper .dataTables_filter,
    .dark .dataTables_wrapper .dataTables_info,
    .dark .dataTables_wrapper .dataTables_processing,
    .dark .dataTables_wrapper .dataTables_paginate {
      color: #d1d5db !important;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button {
      color: inherit !important;
      border: 1px solid #d1d5db !important;
      font-size: 0.8125rem !important;
      padding: 0.25rem 0.75rem !important;
      margin-left: 0.25rem !important;
      border-radius: 0.375rem !important;
      background: white !important;
    }

    .dark .dataTables_wrapper .dataTables_paginate .paginate_button {
      background: #374151 !important;
      border-color: #4b5563 !important;
      color: #d1d5db !important;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button.current,
    .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
      background: var(--primary-color) !important;
      color: white !important;
      border-color: var(--primary-color) !important;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
      background: #f3f4f6 !important;
      border-color: #d1d5db !important;
      color: #1f2937 !important;
    }

    .dark .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
      background: #4b5563 !important;
      border-color: #6b7280 !important;
      color: #f9fafb !important;
    }

    .dataTables_wrapper .dataTables_filter input {
      border: 1px solid #d1d5db !important;
      border-radius: 0.375rem !important;
      padding: 0.375rem 0.75rem !important;
      font-size: 0.8125rem !important;
      background: white !important;
      color: #1f2937 !important;
    }

    .dark .dataTables_wrapper .dataTables_filter input {
      background-color: #374151 !important;
      border-color: #4b5563 !important;
      color: #f9fafb !important;
    }

    .dataTables_wrapper .dataTables_length select {
      border: 1px solid #d1d5db !important;
      border-radius: 0.375rem !important;
      padding: 0.375rem 2rem 0.375rem 0.75rem !important;
      font-size: 0.8125rem !important;
      background: white !important;
      color: #1f2937 !important;
    }

    .dark .dataTables_wrapper .dataTables_length select {
      background-color: #374151 !important;
      border-color: #4b5563 !important;
      color: #f9fafb !important;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      padding: 0.125rem 0.5rem;
      border-radius: 9999px;
      font-size: 0.6875rem;
      font-weight: 500;
    }

    .status-badge.success {
      background-color: rgba(16, 185, 129, 0.1);
      color: rgb(6, 95, 70);
    }

    .dark .status-badge.success {
      background-color: rgba(16, 185, 129, 0.2);
      color: rgb(110, 231, 183);
    }

    .status-badge.warning {
      background-color: rgba(245, 158, 11, 0.1);
      color: rgb(146, 64, 14);
    }

    .dark .status-badge.warning {
      background-color: rgba(245, 158, 11, 0.2);
      color: rgb(253, 186, 116);
    }

    .status-badge.error {
      background-color: rgba(239, 68, 68, 0.1);
      color: rgb(153, 27, 27);
    }

    .dark .status-badge.error {
      background-color: rgba(239, 68, 68, 0.2);
      color: rgb(252, 165, 165);
    }

    .log-output {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.75rem;
      line-height: 1.5;
    }

    .command-btn {
      transition: all 0.2s ease-in-out;
      font-size: 0.8125rem;
    }

    .command-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }

    .dark .command-btn:hover {
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3), 0 2px 4px -1px rgba(0, 0, 0, 0.2);
    }

    .modal-backdrop {
      backdrop-filter: blur(4px);
    }

    .sidebar {
      transition: all 0.3s ease;
    }

    .sidebar-collapsed {
      width: 4rem !important;
    }

    .sidebar-collapsed .sidebar-text {
      display: none !important;
    }

    .sidebar-collapsed .sidebar-section {
      display: none !important;
    }

    .main-content-expanded {
      margin-left: 0 !important;
    }

    .dropdown-action {
      transition: all 0.15s ease;
      font-size: 0.8125rem;
    }

    .dropdown-action:hover {
      background-color: rgba(59, 130, 246, 0.1);
    }

    .dark .dropdown-action:hover {
      background-color: rgba(59, 130, 246, 0.2);
    }

    /* Melhorias na paginação do DataTable */
    .dataTables_wrapper {
      position: relative;
    }

    .dataTables_wrapper .dataTables_paginate {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 0.5rem;
      margin-top: 1rem;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2rem;
      height: 2rem;
      padding: 0 0.5rem;
      margin: 0 0.125rem;
      border-radius: 0.375rem;
      font-size: 0.875rem;
      font-weight: 500;
      transition: all 0.2s;
      border: 1px solid #e5e7eb;
      background-color: #ffffff !important;
    }

    .dark .dataTables_wrapper .dataTables_paginate .paginate_button {
      background-color: #374151 !important;
      border-color: #4b5563;
      color: #d1d5db !important;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button.current {
      background-color: var(--primary-color) !important;
      border-color: var(--primary-color) !important;
      color: #ffffff !important;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button:hover:not(.current):not(.disabled) {
      background-color: #f3f4f6 !important;
      border-color: #d1d5db !important;
      color: #1f2937 !important;
    }

    .dark .dataTables_wrapper .dataTables_paginate .paginate_button:hover:not(.current):not(.disabled) {
      background-color: #4b5563 !important;
      border-color: #6b7280 !important;
      color: #f9fafb !important;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .dataTables_wrapper .dataTables_info {
      margin-top: 1rem;
      color: #6b7280;
    }

    .dark .dataTables_wrapper .dataTables_info {
      color: #9ca3af;
    }

    @media (max-width: 768px) {

      .dataTables_wrapper .dataTables_length,
      .dataTables_wrapper .dataTables_filter,
      .dataTables_wrapper .dataTables_info,
      .dataTables_wrapper .dataTables_paginate {
        width: 100%;
        margin-bottom: 0.5rem;
        justify-content: center;
      }

      .dataTables_wrapper .dataTables_filter input {
        width: 100%;
        max-width: 300px;
      }
    }

    .dropdown-container {
      position: static !important;
    }

    .action-dropdown {
      position: fixed !important;
      z-index: 100 !important;
    }

    /* Estilos para List.js */
    .list-pagination {
      display: flex;
      gap: 0.25rem;
      align-items: center;
    }

    .list-pagination li {
      list-style: none;
    }

    .list-pagination button {
      padding: 0.375rem 0.75rem;
      border-radius: 0.375rem;
      font-size: 0.875rem;
      transition: all 0.2s;
      border: 1px solid #e5e7eb;
      background-color: white;
      color: #374151;
    }

    .dark .list-pagination button {
      background-color: #374151;
      border-color: #4b5563;
      color: #d1d5db;
    }

    .list-pagination button:hover {
      background-color: #f3f4f6;
    }

    .dark .list-pagination button:hover {
      background-color: #4b5563;
    }

    .list-pagination .active button {
      background-color: var(--primary-color);
      border-color: var(--primary-color);
      color: white;
    }

    .dark .list-pagination .active button {
      background-color: var(--primary-color);
      border-color: var(--primary-color);
      color: white;
    }

    .list-pagination .disabled button {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .sort {
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      font-weight: 500;
    }

    .sort:hover {
      color: var(--primary-color);
    }

    .asc .sort-icon:after {
      content: "↑";
    }

    .desc .sort-icon:after {
      content: "↓";
    }

    /* Ajustes para tabelas mais compactas */
    .table-compact td {
      padding: 0.5rem 0.75rem !important;
    }

    .table-compact th {
      padding: 0.5rem 0.75rem !important;
    }

    /* Estilos para a paginação do List.js */
    .pagination {
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    .pagination li {
      list-style: none;
    }

    .pagination button {
      font-size: 0.875rem;
      font-weight: 500;
      transition: all 0.2s ease;
      color: inherit;
      background: none;
      border: none;
      cursor: pointer;
    }

    .pagination button[disabled] {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .pagination button:not([disabled]):hover {
      background-color: rgb(243, 244, 246);
    }

    .dark .pagination button:not([disabled]):hover {
      background-color: rgb(55, 65, 81);
    }

    .pagination button.active {
      background-color: var(--primary-color);
      color: white;
    }

    @media (max-width: 768px) {
      .sidebar {
        transform: translateX(-100%);
      }

      .sidebar.open {
        transform: translateX(0);
      }
    }

    /* CORREÇÃO ADICIONAL PARA OS BOTÕES DE PAGINAÇÃO E CAMPO DE BUSCA NO MODO ESCURO */
    .dataTables_wrapper .dataTables_paginate {
      margin-top: 0.5rem !important;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button {
      background: white !important;
      border: 1px solid #e5e7eb !important;
      padding: 0.375rem 0.75rem !important;
      margin: 0 0.25rem !important;
      border-radius: 0.375rem !important;
      color: #374151 !important;
    }

    .dark .dataTables_wrapper .dataTables_filter label,
    .dark .dataTables_wrapper .dataTables_length label {
      color: #d1d5db !important;
    }

    .dark .dataTables_wrapper .dataTables_filter input::placeholder {
      color: #9ca3af !important;
    }

    .dark .dataTables_wrapper .dataTables_paginate .paginate_button {
      background: #374151 !important;
      border: 1px solid #4b5563 !important;
      color: #d1d5db !important;
    }

    .dark .dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
      background: #4b5563 !important;
      border-color: #6b7280 !important;
      color: #9ca3af !important;
      opacity: 0.5 !important;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button.current {
      background: var(--primary-color) !important;
      border-color: var(--primary-color) !important;
      color: white !important;
    }

    .dark .dataTables_wrapper .dataTables_paginate .paginate_button.current {
      background: var(--primary-color) !important;
      border-color: var(--primary-color) !important;
      color: white !important;
    }

    .dark .dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover {
      background: #4b5563 !important;
      border-color: #6b7280 !important;
      color: #9ca3af !important;
    }

    .dark .dataTables_wrapper .dataTables_paginate .paginate_button.previous,
    .dark .dataTables_wrapper .dataTables_paginate .paginate_button.next {
      background: #374151 !important;
      border-color: #4b5563 !important;
      color: #d1d5db !important;
    }

    .dark .dataTables_wrapper .dataTables_paginate .paginate_button.previous:hover,
    .dark .dataTables_wrapper .dataTables_paginate .paginate_button.next:hover {
      background: #4b5563 !important;
      border-color: #6b7280 !important;
      color: #f9fafb !important;
    }

    /* Estilos adicionais para melhorar a experiência no modo escuro */
    .dark .dataTables_wrapper .dataTables_filter label {
      display: flex;
      align-items: center;
    }

    .dark .dataTables_wrapper .dataTables_filter input {
      caret-color: #f9fafb !important;
    }

    .dark .dataTables_wrapper .dataTables_length select {
      appearance: none;
      -webkit-appearance: none;
      -moz-appearance: none;
      background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3e%3cpath fill='%23d1d5db' d='M7 10l5 5 5-5z'/%3e%3c/svg%3e");
      background-repeat: no-repeat;
      background-position: right 0.5rem center;
      background-size: 1em;
    }

    .dark .dataTables_wrapper .dataTables_length select:focus {
      outline: 2px solid var(--primary-color);
      outline-offset: 2px;
    }
  </style>
</head>

<body
  class="bg-gray-50 dark:bg-gray-900 text-gray-800 dark:text-gray-200 min-h-screen flex flex-col justify-between text-sm">
  <!-- Container principal do conteúdo -->
  <div class="flex flex-col flex-1">
    <!-- Header -->
    <header class="bg-white dark:bg-gray-800 shadow-sm border-b border-gray-200 dark:border-gray-700">
      <div class="flex items-center justify-between px-4 py-2">
        <div class="flex items-center">
          <button id="sidebarToggle"
            class="lg:hidden mr-3 p-1.5 rounded-md text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700">
            <i class="bi bi-list text-lg"></i>
          </button>
          <button id="sidebarCollapse"
            class="hidden lg:flex mr-3 p-1.5 rounded-md text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700">
            <i class="bi bi-layout-sidebar text-lg"></i>
          </button>
          <div class="flex items-center">
            <i class="bi bi-speedometer2 text-xl text-primary-600 dark:text-primary-400 mr-2"></i>
            <h1 class="text-lg font-bold text-gray-900 dark:text-white">Serve Dashboard</h1>
          </div>
        </div>
        <div class="flex items-center space-x-3">
          <!-- Theme Toggle -->
          <button id="themeToggle"
            class="p-1.5 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600">
            <i class="bi bi-sun hidden dark:block text-sm"></i>
            <i class="bi bi-moon block dark:hidden text-sm"></i>
          </button>
          <!-- User Menu -->
          <div class="relative">
            <button id="userMenuButton"
              class="flex items-center space-x-2 p-1 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700">
              <div
                class="w-7 h-7 rounded-full bg-primary-500 flex items-center justify-center text-white font-medium text-sm">
                <i class="bi bi-person"></i>
              </div>
            </button>
            <!-- Dropdown Menu -->
            <div id="userMenu"
              class="absolute right-0 mt-2 w-44 bg-white dark:bg-gray-800 rounded-md shadow-lg py-1 z-10 hidden border border-gray-200 dark:border-gray-700">
              <a href="/"
                class="block px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
                <i class="bi bi-house mr-2"></i>Início
              </a>
              <a href="/dashboard"
                class="block px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
                <i class="bi bi-terminal mr-2"></i>Node
              </a>
              <a href="/caddy"
                class="block px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
                <i class="bi bi-globe mr-2"></i>Domínios
              </a>
              <a href="/docker"
                class="block px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
                <i class="bi bi-box-seam mr-2"></i>Docker
              </a>
              <a href="/git"
                class="block px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
                <i class="bi bi-git mr-2"></i>Git
              </a>
              <a href="/auto"
                class="block px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
                <i class="bi bi-rocket-takeoff mr-2"></i>AutoInstall
              </a>
              <a href="/composer"
                class="block px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-300">
                <i class="bi bi-box mr-2"></i>Composer
              </a>
              <a href="/filemanager"
                class="block px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
                <i class="bi bi-archive mr-2"></i>File Manager
              </a>
              <div class="border-t border-gray-200 dark:border-gray-700 my-1"></div>
              <a href="/logout"
                class="block px-3 py-1.5 text-sm text-red-600 dark:text-red-400 hover:bg-gray-100 dark:hover:bg-gray-700">
                <i class="bi bi-box-arrow-right mr-2"></i>Sair
              </a>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="flex">
      <!-- Sidebar -->
      <aside id="sidebar"
        class="sidebar w-56 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 h-[calc(100vh-49px)] fixed lg:static z-20 transition-all duration-300">
        <nav class="p-3">
          <ul class="space-y-1">
            <li>
              <a href="/"
                class="flex items-center px-3 py-1.5 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-sm">
                <i class="bi bi-house mr-2.5 sidebar-icon"></i>
                <span class="sidebar-text">Início</span>
              </a>
            </li>
            <li>
              <a href="/dashboard"
                class="flex items-center px-3 py-1.5 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-sm">
                <i class="bi bi-terminal mr-2.5 sidebar-icon"></i>
                <span class="sidebar-text">Node</span>
              </a>
            </li>
            <li>
              <a href="/caddy"
                class="flex items-center px-3 py-1.5 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-sm">
                <i class="bi bi-globe mr-2.5 sidebar-icon"></i>
                <span class="sidebar-text">Domínios</span>
              </a>
            </li>
            <li>
              <a href="/docker"
                class="flex items-center px-3 py-1.5 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-sm">
                <i class="bi bi-box-seam mr-2.5 sidebar-icon"></i>
                <span class="sidebar-text">Docker</span>
              </a>
            </li>
            <li>
              <a href="/git"
                class="flex items-center px-3 py-1.5 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-sm">
                <i class="bi bi-git mr-2.5 sidebar-icon"></i>
                <span class="sidebar-text">Git</span>
              </a>
            </li>
            <li>
              <a href="/auto"
                class="flex items-center px-3 py-1.5 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 text-sm">
                <i class="bi bi-rocket-takeoff mr-2.5 sidebar-icon"></i>
                <span class="sidebar-text">AutoInstall</span>
              </a>
            </li>
