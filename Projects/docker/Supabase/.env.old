############
# Docker compose override files to layer on top of docker-compose.yml.
# Native docker compose COMPOSE_FILE: colon-separated list, base file first.
# Manage with: ./run.sh config add|remove <name>
#
# Examples:
#   COMPOSE_FILE=docker-compose.yml
#   COMPOSE_FILE=docker-compose.yml:docker-compose.pg17.yml
#
############
COMPOSE_FILE=docker-compose.yml


############
# Secrets
#
# YOU MUST CHANGE ALL THE DEFAULT VALUES BELOW BEFORE STARTING
# THE CONTAINERS FOR THE FIRST TIME!
#
# Documentation:
# https://supabase.com/docs/guides/self-hosting/docker#configuring-and-securing-supabase
#
# To generate secrets and API keys:
# 1. sh utils/generate-keys.sh
# 2. sh utils/add-new-auth-keys.sh
#
############

# Postgres
POSTGRES_PASSWORD=c098197b264dc0f131d83c5c13d815aa

# Legacy symmetric HS256 key
JWT_SECRET=Pj+c3qXHHUgBc8Okm8aCmAaqlXSuGZ4iF1jCLEyu
# Legacy API keys (HS256-signed JWTs)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzc5NzQ3OTcxLCJleHAiOjE5Mzc0Mjc5NzF9.71UYmbkGY4mfabkFjDJ6DCL8ibzv7OvQIBC29ATBEyE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3Nzk3NDc5NzEsImV4cCI6MTkzNzQyNzk3MX0.pzjVlXxQPH4J51qwDIt2Ui6MYEt7al0FSNcVyhC5b0M

# Asymmetric key pair (ES256) and opaque API keys
#
# Documentation:
# https://supabase.com/docs/guides/self-hosting/self-hosted-auth-keys
#
# To generate:
# sh ./utils/add-new-auth-keys.sh
#
# Opaque API key for client-side use (anon role).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_7-2ktYqaxgtHSTXquuyTWM_3krUnL4k
# Opaque API key for server-side use (service_role). Never expose in client code.
SUPABASE_SECRET_KEY=sb_secret_4bvw2KWO6fVqnAyTHIVlBD_Zcvf8suu
# JSON array of signing JWKs (EC private + legacy symmetric).
# Used by Auth.
JWT_KEYS=[{"kty":"EC","kid":"969f3051-ad39-440e-932e-c22c2207cf2b","use":"sig","key_ops":["sign","verify"],"alg":"ES256","ext":true,"crv":"P-256","x":"IOS0Gf25cFizqd-SCwT_DsYQfikn40XokD3VMQpUO6g","y":"8ypu-mv97fFRZulWMqRgLYoZZxHi2oqcSRiKDsIb_JU","d":"I8XNdPFg-xzbdne7T_X4bqxSkHRFvLlOL9nfrnKSLbQ"},{"kty":"oct","k":"UGorYzNxWEhIVWdCYzhPa204YUNtQWFxbFhTdUdaNGlGMWpDTEV5dQ","alg":"HS256"}]
# JWKS for token verification (EC public + legacy symmetric).
# Used by PostgREST, Realtime, Storage to verify tokens.
JWT_JWKS=

# Access to Dashboard
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=c2e2164a1adedd8b9ee7ca5219e033cf

# Used by Realtime and Supavisor
SECRET_KEY_BASE=U8WPDAjKmmeg71wPTmxf9qnR8rUHDJIkiWjk3J9e0QFculhVF5kZZ7e+YzNkNEw9

# Used by Supavisor
VAULT_ENC_KEY=ccf84d538a8a633f4a0dc3aa2c9074d8

# Used by Studio to access Postgres via postgres-meta
PG_META_CRYPTO_KEY=97DegxFnRjwH/xYK6UgKfog0ymjXizde

# Analytics - API tokens for log ingestion/querying, and for management
LOGFLARE_PUBLIC_ACCESS_TOKEN=LvUcJIv5b6k1AgPULGVhBYiv7ms+F/VA
LOGFLARE_PRIVATE_ACCESS_TOKEN=PId4ThtLYxrdw6CFq0WoFV2RBggu2nRQ

